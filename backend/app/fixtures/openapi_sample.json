        "operationId": "get_order_orders__id__get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "조회할 주문 번호. 주문 완료 시 발급된 식별자입니다.",
              "title": "Id"
            },
            "description": "조회할 주문 번호. 주문 완료 시 발급된 식별자입니다."
          }
