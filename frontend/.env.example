# frontend 환경변수
#
# 이 파일을 .env.local 로 복사해서 쓴다. .env.local 은 커밋하지 않는다.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ 접두사가 붙은 변수는 이 프로젝트에 없다. 의도적이다 —
# 그 접두사는 값을 빌드 타임에 클라이언트 번들로 박아넣어서
# 단일 이미지를 여러 환경으로 승격하지 못하게 만든다.

# 대시보드 API(backend)의 베이스 URL. 서버 컴포넌트에서만 읽는다.
# 런타임 값이므로 이미지를 다시 빌드하지 않고 환경마다 바꿀 수 있다.
API_BASE_URL=http://localhost:8000

# 서브패스 배포 시의 접두사. 루트 배포면 비워둔다.
# 빌드 타임에 고정되는 값이다 (next.config.ts).
# 예: /swagger-eval
BASE_PATH=


# ===========================================================================
# 사내망 전용 — 패키지 설치·빌드용. 앱 런타임과는 무관하다
# ===========================================================================
#
# 아래는 **셸 환경변수로** 설정한다. npm 과 node 는 이 .env 파일을 읽지 않는다.
# 설정 여부는 `make doctor` 로 확인한다.

# NODE_EXTRA_CA_CERTS
#   사내 CA 인증서 경로. 사내 프록시가 TLS 를 재서명하는 환경에서 필요하다.
#   npm 뿐 아니라 next build, openapi-typescript 등 모든 Node 프로세스에
#   적용되므로 .npmrc 의 cafile 보다 이쪽을 권장한다.
#
#     macOS / Linux:
#       export NODE_EXTRA_CA_CERTS=/path/to/corp-ca-bundle.pem
#     Windows PowerShell:
#       setx NODE_EXTRA_CA_CERTS "C:\path\to\corp-ca-bundle.pem"
#
#   표준 배포 경로는 docs/open-questions.md #43 참고.
# NODE_EXTRA_CA_CERTS=

# 사내 npm registry 는 이 파일이 아니라 frontend/.npmrc 에 설정한다.
# .npmrc.example 를 복사해서 쓴다. .npmrc 자체는 커밋하지 않는다.
